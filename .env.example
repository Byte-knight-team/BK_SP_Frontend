# Backend API base URL
VITE_API_BASE_URL=

# Cloudinary image upload configuration
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Kitchen-scoped uploader (src/components/kitchen/menu/CloudinaryImageUpload.jsx)
# reads its own separate env var names — usually the same account/preset as above
VITE_KITCHEN_CLOUDINARY_CLOUD_NAME=
VITE_KITCHEN_CLOUDINARY_UPLOAD_PRESET=

# Google Maps API Key (Customer - optional, location picker won't show without it)
VITE_GOOGLE_MAPS_CUSTOMER_API_KEY=
